# Copy to .env for local runs. No keys: auth uses `az login` (DefaultAzureCredential).

# Your Foundry / Azure OpenAI resource endpoint (either form works):
#   https://<account>.services.ai.azure.com
#   https://<account>.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://<account>.services.ai.azure.com

# Name of your model DEPLOYMENT (not the model family). Needs function calling + JSON schema output,
# e.g. gpt-4.1-mini, gpt-4o-mini, gpt-5.4-mini.
MODEL_DEPLOYMENT_NAME=gpt-4.1-mini

# Model options. Reasoning models (gpt-5, o-series) reject temperature: leave it unset for them.
# MODEL_TEMPERATURE=0
# MODEL_REASONING_EFFORT=low          # gpt-5: minimal|low|medium|high

# Local credential: default (DefaultAzureCredential) | azd (`azd auth login`) | cli (`az login`)
# AZURE_CREDENTIAL=azd
# AZURE_TENANT_ID=<tenant-guid>       # needed if your login's home tenant differs from the subscription's

# Optional
# AZURE_TOKEN_SCOPE=https://ai.azure.com/.default   # use https://cognitiveservices.azure.com/.default if you get 401s
# REQUEST_TIMEOUT_SECONDS=30
# MAX_TOOL_ROUNDS=3
# HISTORY_TURNS=6
# SKILL_AGENT_TRACE=1
# SKILL_AGENT_FAKE_MODEL=1      # offline scripted model, no Azure calls (tests/demo only)

# When hosted in Foundry, FOUNDRY_PROJECT_ENDPOINT is injected by the platform and used if
# AZURE_OPENAI_ENDPOINT is not set. Do not set FOUNDRY_* variables yourself in azure.yaml.

# ---- Salesforce Agentforce skill (optional; skill reports "not configured" without these) ----
# SALESFORCE_MY_DOMAIN=https://<mydomain>.my.salesforce.com     # My Domain URL, not lightning.force.com
# SALESFORCE_CLIENT_ID=<External Client App consumer key>
# SALESFORCE_AGENTFORCE_ID=0Xx...                               # Agentforce agent id (Setup > Agents)
# SALESFORCE_KEYVAULT_URL=https://<vault>.vault.azure.net/      # preferred: secret read with your Azure identity
# SALESFORCE_SECRET_NAME=salesforce-client-secret
# SALESFORCE_CLIENT_SECRET=<consumer secret>                    # local-dev fallback only; never commit .env
# SALESFORCE_API_BASE=https://api.salesforce.com                # api.gov.salesforce.com for Government Cloud
# SALESFORCE_BYPASS_USER=true                                  # set false for Employee agents if session start is rejected
# SALESFORCE_TIMEOUT_SECONDS=60
# SALESFORCE_SESSION_IDLE_SECONDS=600

# ---- Snowflake Cortex Agent skill (optional) ----
# SNOWFLAKE_ACCOUNT_URL=https://<orgname>-<account>.snowflakecomputing.com
# SNOWFLAKE_AGENT_DATABASE=<db>
# SNOWFLAKE_AGENT_SCHEMA=<schema>
# SNOWFLAKE_AGENT_NAME=<agent>
# SNOWFLAKE_PAT=<programmatic access token>     # local dev only; hosted reads `snowflake-pat` from Key Vault
# SNOWFLAKE_KEYVAULT_URL=https://<vault>.vault.azure.net/
# SNOWFLAKE_TIMEOUT_SECONDS=120
